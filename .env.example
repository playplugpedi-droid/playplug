# Copy this file to .env and fill in what you have.
# Every platform is optional — the tool skips platforms without credentials.

# ── YouTube (https://console.cloud.google.com) ─────────────────────────────
# 1. Create a project, enable "YouTube Data API v3"
# 2. OAuth consent screen: External, add yourself as a test user
# 3. Credentials → Create OAuth client ID → Desktop app
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── TikTok (https://developers.tiktok.com) ─────────────────────────────────
# 1. Create an app, add the "Content Posting API" product
# 2. Register the redirect URI http://localhost:8080/ (used by `auth tiktok`)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/

# ── Facebook Page (https://developers.facebook.com) ────────────────────────
# Create an app (Business type), get a Page access token with
# pages_manage_posts + pages_read_engagement, then a long-lived one.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ── Instagram Business/Creator (via Facebook app above) ────────────────────
# Account must be a Business or Creator account linked to the Facebook Page.
# INSTAGRAM_USER_ID is the IG user id, not your handle.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
